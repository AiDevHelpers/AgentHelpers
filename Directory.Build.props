<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Richard Sperry</Authors>
    <Company>AiDevHelpers</Company>
    <RepositoryUrl>https://github.com/AiDevHelpers/AgentHelpers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Version comes from version.json via Nerdbank.GitVersioning. -->
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" PrivateAssets="all" />
  </ItemGroup>
</Project>
